  <part-list>
    <score-part id="P1"><part-name>Chromatic scale (gamme chromatique)</part-name></score-part>
    <score-part id="P2"><part-name>Open (à vide)</part-name></score-part>
    <score-part id="P3"><part-name>2nd valve: lowers a half step</part-name></score-part>
    <score-part id="P4"><part-name>1st valve: lowers a whole step</part-name></score-part>
    <score-part id="P5"><part-name>1st and 2nd valves, or the 3rd alone: lower a step and a half</part-name></score-part>
    <score-part id="P6"><part-name>2nd and 3rd valves: lower two whole steps</part-name></score-part>
    <score-part id="P7"><part-name>1st and 3rd valves: lower two and a half steps</part-name></score-part>
    <score-part id="P8"><part-name>1st, 2nd and 3rd valves: lower three whole steps</part-name></score-part>
  </part-list>
