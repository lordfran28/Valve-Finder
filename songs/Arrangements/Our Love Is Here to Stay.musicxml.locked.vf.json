 "details": {
  "title": "Our Love Is Here to Stay",
  "lead": "Rod Stewart's singing on his record, an octave up for the trumpet and in his key, G. His phrasing is straightened into plain eighths, and his slides and turns are left out. It runs from concert C♯4 to G5 (written D♯4 to A5); the G5 comes once, in the last A.",
  "facts": [
   [
    "Song",
    "George Gershwin, words by Ira Gershwin (1938)"
   ],
   [
    "Line",
    "Rod Stewart's voice, read note by note from the vocal track and straightened"
   ],
   [
    "Key",
    "G concert, A for the trumpet"
   ],
   [
    "Form",
    "Pickup, A, middle, A, last part; eight bars for the band; middle, A, last part longer"
   ]
  ]
 }
