 "details": {
  "title": "Rainy Days and Mondays, after Karen Carpenter",
  "lead": "Karen Carpenter's line, note for note from the record, on the record's own beats (about 76), in E-flat (F for the trumpet), concert F3 to B-flat 4; the last part goes up to F (G for the trumpet). The introduction's held harmonica note is there too. Her slides into a note are the small boxes on top; her long notes are written as one note under her wide vibrato. It rests where the band plays alone, and breathes at the ends of her lines.",
  "facts": [
   [
    "Song",
    "Rainy Days and Mondays, by Roger Nichols and Paul Williams; the Carpenters, Carpenters (1971)"
   ],
   [
    "Line",
    "Her voice, read from the record's vocal track and written on eighths, her slides as small notes"
   ],
   [
    "Key",
    "E-flat major concert (F for the trumpet); from bar 53, F major (G for the trumpet)"
   ],
   [
    "Plays with",
    "The record (05._Rainy_Days_And_Mondays.mp3)"
   ]
  ]
 }
