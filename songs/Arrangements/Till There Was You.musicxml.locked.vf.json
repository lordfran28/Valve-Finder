 "details": {
  "title": "Till There Was You",
  "lead": "Rod Stewart's singing on his record, an octave up for the trumpet and in his key, E. His phrasing is straightened, his slides left out. It runs from concert D♯4 to G5 (written E♯4 to A5); the G5 comes once, in the first bridge. The eight bars without him are left as rests.",
  "facts": [
   [
    "Song",
    "Meredith Willson, from The Music Man (1957)"
   ],
   [
    "Line",
    "Rod Stewart's voice, read note by note from the vocal track and straightened"
   ],
   [
    "Key",
    "E concert, F♯ for the trumpet"
   ],
   [
    "Form",
    "Intro; A, A, bridge, A; eight bars without voice; bridge, last A"
   ]
  ]
 }
